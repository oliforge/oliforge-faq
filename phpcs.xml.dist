<?xml version="1.0"?>
<ruleset name="OliForge FAQ">
	<description>Code-quality ruleset for the OliForge FAQ plugin.</description>

	<file>.</file>
	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/languages/*</exclude-pattern>
	<exclude-pattern>/build/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="basepath" value="."/>
	<arg value="sp"/>

	<config name="minimum_wp_version" value="6.5"/>
	<config name="testVersion" value="7.4-"/>

	<!-- Code-quality rules that matter for security, data, i18n and compatibility. Pure formatting
	     rules (tabs, spacing, comment style) are intentionally not enabled: the project uses 4-space indentation. -->
	<rule ref="PHPCompatibilityWP"/>
	<rule ref="WordPress.Security"/>
	<rule ref="WordPress.DB"/>
	<rule ref="WordPress.WP"/>
	<rule ref="WordPress.CodeAnalysis"/>
	<rule ref="WordPress.Utils"/>
	<rule ref="WordPress.DateTime"/>
	<rule ref="WordPress.PHP.DiscouragedPHPFunctions"/>
	<rule ref="WordPress.PHP.DevelopmentFunctions"/>
	<rule ref="WordPress.PHP.DontExtract"/>
	<rule ref="WordPress.PHP.NoSilencedErrors"/>
	<rule ref="WordPress.PHP.RestrictedPHPFunctions"/>
	<rule ref="WordPress.PHP.StrictInArray"/>
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals"/>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array"><element value="oliforge_faq"/><element value="OliForge_FAQ"/><element value="OLIFORGE_FAQ"/></property>
		</properties>
	</rule>
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array"><element value="oliforge-faq"/></property>
		</properties>
	</rule>
	<rule ref="WordPress.WP.PostsPerPage">
		<properties><property name="posts_per_page" value="250"/></properties>
	</rule>
	<rule ref="WordPress.Security.EscapeOutput">
		<properties>
			<property name="customEscapingFunctions" type="array"><element value="oliforge_kses"/></property>
		</properties>
	</rule>

	<!--
	Read-only GET parameters (filters, search phrase, which record to view) never change state;
	nonces protect state-changing requests. WPCS itself ranks this as "Recommended", not "Missing",
	and every state-changing handler still verifies a nonce.
	-->
	<rule ref="WordPress.Security.NonceVerification">
		<exclude name="WordPress.Security.NonceVerification.Recommended"/>
	</rule>
</ruleset>
